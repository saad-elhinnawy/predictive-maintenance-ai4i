# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/bmw_export

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Express
PORT=4000
NODE_ENV=development

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:3000

# Frontend URL used in email links
APP_URL=http://localhost:3000

# SendGrid (uncomment src/services/email.ts lines to enable)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# MarineTraffic API
# MARINETRAFFIC_API_KEY=your_marinetraffic_api_key
# MARINETRAFFIC_BASE_URL=https://services.marinetraffic.com/api

# MarineTraffic webhook — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MARINETRAFFIC_WEBHOOK_SECRET=replace-with-a-long-random-secret
